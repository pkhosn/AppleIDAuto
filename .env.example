# Copy this file to .env during manual deployment.
# Do not commit the real .env file. The installer can generate these values
# automatically for a fresh deployment. See docs/deployment.md.

# Application
APP_DEBUG = false
API_KEY = replace-with-panel-api-key

# Legacy-compatible task options still read by current API endpoints
WEBDRIVER = http://127.0.0.1:4444
TASK_HEADLESS = true
FAIL_RETRY = true
SHARE_RANDOM = true

# Managed static proxies and extraction sources; dynamic IP pool is removed.
ENABLE_PROXY_POOL = false
PROXY_FAILURE_THRESHOLD = 3
PROXY_COOLDOWN_SECONDS = 1800
PROXY_HEALTH_INTERVAL = 300

[CREDENTIALS]
# Independent field-encryption key. Generate with: php think credentials:key --show
CIPHER_KEY = replace-with-32-byte-base64-credentials-cipher-key

[BACKEND]
# PHP panel calls the Docker automation-server through this URL.
ENABLE_API = true
API_URL = http://127.0.0.1:3939
TOKEN = replace-with-automation-token
CONNECT_TIMEOUT = 3
READ_TIMEOUT = 10

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = appleid
USERNAME = appleid
PASSWORD = replace-with-database-password
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX =

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai
CHARSET = utf8mb4

[MAILBOX]
# Generate with: php think mailbox:key --show
# Must remain stable after mailbox credentials are saved in the panel.
CIPHER_KEY = replace-with-32-byte-base64-mailbox-cipher-key
