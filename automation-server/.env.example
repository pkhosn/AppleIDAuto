# Compose 中调度服务与驱动共用此文件。占位令牌需替换为独立的至少 32 字符随机值。
# 其他字段及安装向导行为见 docs/configuration.md 和 docs/deployment.md。
AUTOMATION_TOKEN=replace-with-a-long-random-token
# PHP 管理站的实际可达根地址，公网使用 HTTPS，需匹配虚拟主机和证书。
# 已有受限 Docker 内网 HTTP API 入口时可保留其根地址，详见 docs/deployment.md。
PANEL_URL=https://apple.example.com
PANEL_API_KEY=replace-with-panel-api-key
REDIS_URL=redis://redis:6379/0
DATABASE_PATH=/data/tasks.sqlite3
MAX_RETRIES=3
REQUEST_TIMEOUT=10
POLL_INTERVAL=2
ACCOUNT_DRIVER_URL=http://account-driver:3940
ACCOUNT_DRIVER_TOKEN=replace-with-driver-token
ACCOUNT_DRIVER_POLL_INTERVAL=2
ACCOUNT_DRIVER_JOB_TIMEOUT=930
ACCOUNT_DRIVER_QUEUE_TIMEOUT=1800
WORKER_CONCURRENCY=3
ACCOUNT_LOCK_TTL=600
TECHNICAL_RETRY_DELAYS=30,120,300
WORKFLOW_V2_ENABLED=false
WORKFLOW_V2_PERCENT=10
SCHEDULE_JITTER_SECONDS=180
RECONCILIATION_COOLDOWN_SECONDS=900
PROXY_HEALTH_CONCURRENCY=10
PROXY_RETRY_SECONDS=300
PROXY_LOOP_INTERVAL=60
PROXY_CHECK_URL=https://api.ipify.org?format=json
PROXY_TARGET_URL=https://account.apple.com/
PROXY_SOURCE_MAX_BYTES=1048576
PROXY_SOURCE_MAX_ENDPOINTS=500
ALLOW_PRIVATE_PROXY_SOURCE=false
DRIVER_CONCURRENCY=1
DRIVER_JOB_TTL=3600
DRIVER_ACTION_TIMEOUT=900
CAPTCHA_RETRIES=5
CAPTCHA_HUMAN_TIMEOUT=180
CAPTCHA_HUMAN_ATTEMPTS=3
TELEGRAM_POLL_TIMEOUT=25
ARTIFACT_DIR=/data/artifacts
ARTIFACT_DAYS=5
PASSWORD_PREFIX=Aa1@
ACCOUNT_SIGN_IN_URL=https://account.apple.com/sign-in
ACCOUNT_URL=https://account.apple.com/
ACCOUNT_RECOVERY_URL=https://iforgot.apple.com/password/verify/appleid
PROXY_BRIDGE_HOST=account-driver
PROXY_BRIDGE_PORT_START=18080
# 邮箱凭据在管理站配置并加密保存，根 .env 需要独立的 [MAILBOX] CIPHER_KEY。
